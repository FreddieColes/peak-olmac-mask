<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>OlMacMask</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(HOME)/peak/PEAK_Data/Managed</ManagedDir>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CS0618;CS0436;MSB3277;MSB3243</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
  </ItemGroup>
  <ItemGroup>
    <GameDll Include="$(ManagedDir)/*.dll"
             Exclude="$(ManagedDir)/mscorlib.dll;$(ManagedDir)/netstandard.dll;$(ManagedDir)/System*.dll;$(ManagedDir)/Mono*.dll;$(ManagedDir)/Microsoft*.dll;$(ManagedDir)/Accessibility.dll;$(ManagedDir)/Newtonsoft.Json.dll" />
    <Reference Include="@(GameDll)" Private="false" />
  </ItemGroup>
</Project>
